# Copiar a .env y completar. .env está ignorado por git: nunca subir credenciales.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria   # obligatoria; generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Para tener varios stacks a la vez (un worktree por rama): un nombre de proyecto propio y puertos distintos en cada .env
# (el principal usa los valores por defecto: 8000 y 5433; el siguiente, por ejemplo, 8010 y 5443)
COMPOSE_PROJECT_NAME=cofrial
WEB_PUERTO=8000
DB_PUERTO=5433
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# 1 cuando la web va detrás de HTTPS: activa cookies seguras, HSTS y redirección (con HTTP plano déjalo en 0)
DJANGO_HTTPS=0
# Límites de intentos (opcionales; estos son los valores por defecto):
# ACCESO_MAX_FALLOS_CUENTA=10          # claves malas seguidas para una misma cuenta antes de bloquearla 15 minutos
# ACCESO_MAX_FALLOS_IP=0               # 0 = sin límite por IP: en la defensa toda la sala sale por una sola IP pública
# ESCANEO_MAX_404=60                   # «no encontrado» por IP en la ventana antes de responder 429 (un barrido de 30 páginas pasa)
# ESCANEO_VENTANA_SEG=600
# LIMITE_REGISTRO_HORA=10              # registros por IP y hora
# LIMITE_SOPORTE_HORA=20               # consultas a soporte por IP y hora (cada una gasta cuota de la IA)
DB_NAME=cofrial
DB_USER=cofrial
DB_PASSWORD=cambiar-esta-clave
DB_HOST=db
DB_PORT=5432
DEMO_PASSWORD=cambiar-clave-de-demo
INTERVALO_SEG=5
PROB_RUPTURA=0.001
# Velocidad simulada de los camiones: 120 = modo demostración (un reparto termina en minutos); 30 coincide con la ETA de la web
CONFIRMACION_AUTO_SEG=120   # segundos que tiene el cliente para confirmar la entrega en la puerta antes de darla por recibida (demostración; en la vida real, horas)
OSRM_URL=https://router.project-osrm.org   # servicio de rutas por calles (el servidor calcula y guarda cada ruta; vacío = rectas aproximadas)
VELOCIDAD_MEDIA_KMH=50      # velocidad media de reparto: la usan el simulador IoT y la hora de llegada de la tienda
FACTOR_CALLES=1.3
# Tablero de BI (Grafana, se abre en /bi/ con la sesión de la aplicación: admin y gerencia): usuario de solo lectura de la base y clave interna del tablero
GRAFANA_DB_PASSWORD=cambiar-clave-solo-lectura
GRAFANA_PASSWORD=cambiar-clave-admin-grafana
# Botón «Precargar datos de ejemplo» en el registro (1 = visible, 0 = oculto)
REGISTRO_PRECARGA=1
# IA externa gratuita (Google AI Studio -> Get API key). La clave nunca va al repositorio. Respaldo opcional: Groq
# Mosaicos del mapa. Vacío = OpenStreetMap (sin clave; exige enviar el Referer y mostrar la atribución, ya resuelto en la web).
# Para otro proveedor, poner su URL con {z}/{x}/{y} (y su clave dentro de la URL si la pide) y su atribución. Ojo: Carto ya no es gratis sin clave.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_MAX_ZOOM=
MAP_TILE_SUBDOMAINS=
GEMINI_API_KEY=
# Opcional: modelos de Gemini separados por coma, en orden de preferencia. Vacío = los del código (hoy gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.5-flash)
GEMINI_MODELS=
GROQ_API_KEY=
# Opcional: orden de los proveedores de IA (gemini,groq por defecto) y modelos de Groq
# Proveedores del asistente de la tienda (chat); el orden por defecto es groq,gemini porque Groq responde en menos de 1 s.
ASISTENTE_ACTIVO=1
IA_CHAT_PROVEEDORES=
IA_PROVEEDORES=
GROQ_MODELS=
