="g"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f4" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontSize=12;fontStyle=1;" edge="1" parent="1" source="g" target="v4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="e1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontSize=12;fontStyle=1;" edge="1" parent="1" source="g" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="leyenda" value='&lt;b&gt;Puntos de dolor&lt;/b&gt;&lt;br/&gt;&lt;b style="color:#c0392b"&gt;1&lt;/b&gt;  Cartera personal: los contactos viven en el celular del vendedor y se van con él.&lt;br/&gt;&lt;b style="color:#c0392b"&gt;2&lt;/b&gt;  Canales informales: sin registro de lo conversado.&lt;br/&gt;&lt;b style="color:#c0392b"&gt;3&lt;/b&gt;  Sin etapas ni métricas: nadie sabe cuántos prospectos hay ni en qué punto están.&lt;br/&gt;&lt;b style="color:#c0392b"&gt;4&lt;/b&gt;  Pérdidas sin motivo registrado: no se aprende de las ventas no concretadas.' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="474" width="1436" height="126" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>