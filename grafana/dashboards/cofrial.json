    {
     "datasource": {
      "type": "postgres",
      "uid": "cofrial-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT coalesce(sum(t.total_clp),0) AS ventas FROM v_orden o JOIN v_orden_total t USING (orden_id)\nJOIN estado_orden e ON e.estado_orden_id = o.estado_orden_id WHERE e.nombre <> 'Cancelada' AND $__timeFilter(o.creada_en)"
    }
   ],
