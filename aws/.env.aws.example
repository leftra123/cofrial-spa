# Copiar a .env en CADA EC2 y completar. .env está ignorado por git: nunca subir credenciales.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# Seguridad (opcionales; por defecto la demostración sigue funcionando por HTTP en la IP elástica):
# DJANGO_ADMIN_URL=panel-cambiame/     # mueve /admin/ a una ruta que solo conoce el equipo
# DJANGO_HTTPS=1                       # solo cuando todo visitante llega por HTTPS: cookies Secure y HSTS
# DJANGO_HSTS_SEG=86400                # segundos de HSTS con DJANGO_HTTPS=1 (vacío = un año; provision.sh usa un día)
# DJANGO_CSP=1                         # política de contenido (CSP): 1 se aplica · informe solo avisa en la consola del navegador · 0 sin cabecera
# DJANGO_CONFIAR_PROXY=1               # solo detrás de un balanceador (usa X-Forwarded-For para contar intentos por IP)
# Límites de intentos (opcionales; estos son los valores por defecto):
# ACCESO_MAX_FALLOS_CUENTA=10          # claves malas seguidas para una misma cuenta antes de bloquearla 15 minutos
# ACCESO_MAX_FALLOS_IP=0               # 0 = sin límite por IP: en la defensa toda la sala sale por una sola IP pública
# ESCANEO_MAX_404=60                   # «no encontrado» por IP en la ventana antes de responder 429 (un barrido de 30 páginas pasa)
# ESCANEO_VENTANA_SEG=600
# LIMITE_REGISTRO_HORA=10              # registros por IP y hora
# LIMITE_SOPORTE_HORA=20               # consultas a soporte por IP y hora (cada una gasta cuota de la IA)
# LIMITE_RECUPERAR_HORA=10             # pedidos de enlace «olvidé mi clave» por IP y hora
# Orígenes públicos con esquema, separados por coma: el DNS del balanceador (ALB) y el dominio (obligatorio para que los formularios funcionen tras el balanceo)
DJANGO_CSRF_ORIGINS=http://DNS-DEL-ALB,https://DNS-DEL-ALB
# Alta disponibilidad (dos EC2 web detrás del ALB): `provision.sh` los escribe solos. A mano: ROL_WEB=primario en UNA web y secundario en la otra.
DJANGO_CONFIAR_PROXY=1               # detrás del ALB: X-Forwarded-For/Proto de confianza
# DJANGO_HTTPS=1 y DJANGO_HTTPS_REDIRECT=0 solo con certificado de confianza en el ALB (el ALB redirige, Django no)
DJANGO_HTTPS_REDIRECT=0
ROL_WEB=primario
# INSTANCIA_EC2=i-0123456789abcdef0   # la escribe provision.sh; la Torre de control la muestra
# Endpoint de RDS (consola de RDS > la instancia > Conectividad > Punto de enlace)
DB_HOST=cofrial-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=cofrial
DB_USER=cofrial
DB_PASSWORD=cambiar-esta-clave
DB_SSLMODE=require
# Base de las claves de las cuentas de prueba: cada cuenta deriva la suya. La hoja con todas: python3 web/clientes/cuentas_demo.py --env .env
DEMO_PASSWORD=cambiar-clave-de-demo
# Tablero de BI (Grafana, se abre en /bi/ con la sesión de la aplicación: admin y gerencia): usuario de solo lectura de la base y clave interna del tablero
GRAFANA_DB_PASSWORD=cambiar-clave-solo-lectura
GRAFANA_PASSWORD=cambiar-clave-admin-grafana
# Simulador IoT (EC2 dedicada)
INTERVALO_SEG=5
# 0 = ninguna ruptura espontánea: las caídas de frío se provocan desde /demo/ (escenarios)
PROB_RUPTURA=0
# Días que se conservan las lecturas normales de telemetría; alertas, viajes y la última de cada camión no se borran
RETENCION_TELEMETRIA_DIAS=7
# Reparto y despacho (opcionales; valores por defecto). El detalle de cada una está en .env.example de la raíz.
# VELOCIDAD_MEDIA_KMH=50
# FACTOR_CALLES=1.3
# CONFIRMACION_AUTO_SEG=120
# DESPACHO_AUTO=0
# OSRM_URL=https://router.project-osrm.org
# FORZAR_CARGA_DEMO=0
# Mapa y asistente (opcionales)
# MAP_STYLE_URL=
# ASISTENTE_ACTIVO=1
# IA_CHAT_PROVEEDORES=
# IA externa gratuita (Google AI Studio -> Get API key). Respaldo opcional: Groq
GEMINI_API_KEY=
# Opcional: modelos de Gemini separados por coma, en orden de preferencia. Vacío = los del código
GEMINI_MODELS=
GROQ_API_KEY=
# Opcional: orden de los proveedores de IA (por defecto gemini,groq; groq,gemini usa primero el más rápido) y modelos de Groq
IA_PROVEEDORES=
GROQ_MODELS=
# Claude: tercer proveedor de IA, opcional y de pago. Vacío = solo Gemini y Groq. CLAUDE_MODELS cambia el modelo (por defecto claude-opus-5-5).
ANTHROPIC_API_KEY=
CLAUDE_MODELS=
# Mercado Pago Payment Brick (B2C, modo prueba). Vacío = cobro simulado. Claves TEST del panel de desarrolladores de Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_PAYER_EMAIL=

# Correo para «¿Olvidaste tu clave?» (opcional). Vacío = el correo se escribe en el registro: docker compose -f aws/docker-compose.web.yml logs web
# Gmail: activar la verificación en dos pasos y crear una «clave de aplicación» (16 letras) en https://myaccount.google.com/apppasswords
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Opcional: remitente visible, p. ej. Cofrial SpA <cuenta@gmail.com>. Vacío = Cofrial SpA <EMAIL_HOST_USER>
EMAIL_REMITENTE=
# Base de la clave de las cuentas administradoras (admin@ y eric@); cada una deriva la suya. Vacío = usan DEMO_PASSWORD
ADMIN_PASSWORD=
