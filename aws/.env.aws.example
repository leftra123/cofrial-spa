# Copiar a .env en CADA EC2 y completar. .env está ignorado por git: nunca subir credenciales.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# Seguridad (opcionales; por defecto la demostración sigue funcionando por HTTP en la IP elástica):
# DJANGO_ADMIN_URL=panel-cambiame/     # mueve /admin/ a una ruta que solo conoce el equipo
# DJANGO_HTTPS=1                       # solo con certificado: cookies seguras y HSTS
# DJANGO_CONFIAR_PROXY=1               # solo detrás de un balanceador (usa X-Forwarded-For para contar intentos por IP)
# Límites de intentos (opcionales; estos son los valores por defecto):
# ACCESO_MAX_FALLOS_CUENTA=10          # claves malas seguidas para una misma cuenta antes de bloquearla 15 minutos
# ACCESO_MAX_FALLOS_IP=0               # 0 = sin límite por IP: en la defensa toda la sala sale por una sola IP pública
# ESCANEO_MAX_404=60                   # «no encontrado» por IP en la ventana antes de responder 429 (un barrido de 30 páginas pasa)
# ESCANEO_VENTANA_SEG=600
# LIMITE_REGISTRO_HORA=10              # registros por IP y hora
# LIMITE_SOPORTE_HORA=20               # consultas a soporte por IP y hora (cada una gasta cuota de la IA)
# IP elástica o dominio público de la EC2 web, con esquema (obligatorio para que los formularios funcionen tras el balanceo/proxy)
DJANGO_CSRF_ORIGINS=http://IP-ELASTICA-DE-LA-EC2-WEB
# Endpoint de RDS (consola de RDS > la instancia > Conectividad > Punto de enlace)
DB_HOST=cofrial-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=cofrial
DB_USER=cofrial
DB_PASSWORD=cambiar-esta-clave
DB_SSLMODE=require
DEMO_PASSWORD=cambiar-clave-de-demo
# Tablero de BI (Grafana): usuario de solo lectura de la base y cuenta admin del tablero
GRAFANA_DB_PASSWORD=cambiar-clave-solo-lectura
GRAFANA_PASSWORD=cambiar-clave-admin-grafana
GRAFANA_VISOR_PASSWORD=cambiar-clave-visor-grafana   # cuenta "visor": solo mira el tablero
# Simulador IoT (EC2 dedicada)
INTERVALO_SEG=5
PROB_RUPTURA=0.01
# IA externa gratuita (Google AI Studio -> Get API key). Respaldo opcional: Groq
GEMINI_API_KEY=
# Opcional: modelos de Gemini separados por coma, en orden de preferencia. Vacío = los del código
GEMINI_MODELS=
GROQ_API_KEY=
# Opcional: orden de los proveedores de IA (por defecto gemini,groq; groq,gemini usa primero el más rápido) y modelos de Groq
IA_PROVEEDORES=
GROQ_MODELS=
# Clave inicial de las cuentas administradoras (admin@ y eric@); solo se aplica al crearlas. Vacío = usan DEMO_PASSWORD
ADMIN_PASSWORD=
