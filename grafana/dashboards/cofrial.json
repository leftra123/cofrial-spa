  {
   "id": 11,
   "title": "Pedidos afectados por ruptura de frío",
   "type": "table",
   "datasource": {
    "type": "postgres",
    "uid": "cofrial-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "postgres",
      "uid": "cofrial-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT o.orden_id AS \"Orden\", c.nombre AS \"Cliente\", o.canal AS \"Canal\", d.camion_id AS \"Camión\", count(m.*) AS \"Lecturas con alerta\", t.total_clp AS \"Monto (CLP)\"\nFROM v_orden o JOIN v_orden_total t USING (orden_id) JOIN cliente c ON c.cliente_id = o.cliente_id\nJOIN despacho d ON d.despacho_id = o.despacho_id\nJOIN telemetria m ON m.camion_id = d.camion_id AND m.alerta_ruptura_frio AND m.registrado_en >= d.salida_en AND m.registrado_en <= COALESCE(d.llegada_en, now())\nWHERE d.salida_en IS NOT NULL GROUP BY 1,2,3,4,6 ORDER BY 5 DESC"
    }
   ],
   "description": "",
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
