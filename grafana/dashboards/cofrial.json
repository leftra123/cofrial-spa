  {
   "id": 7,
   "title": "Ventas vs alertas de frío en el tiempo",
   "type": "timeseries",
   "datasource": {
    "type": "postgres",
    "uid": "cofrial-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 16,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "postgres",
      "uid": "cofrial-pg"
     },
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT $__timeGroupAlias(o.creada_en,'10m'), o.canal AS metric, sum(t.total_clp) AS value FROM v_orden o JOIN v_orden_total t USING (orden_id)\nJOIN estado_orden e ON e.estado_orden_id = o.estado_orden_id WHERE e.nombre <> 'Cancelada' AND $__timeFilter(o.creada_en) GROUP BY 1,2 ORDER BY 1"
    },
    {
     "datasource": {
      "type": "postgres",
      "uid": "cofrial-pg"
     },
     "refId": "B",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT $__timeGroupAlias(registrado_en,'10m'), 'Alertas de frío' AS metric, count(*) AS value FROM telemetria WHERE alerta_ruptura_frio AND $__timeFilter(registrado_en) GROUP BY 1 ORDER BY 1"
    }
   ],
   "description": "Cruce pedido por la pauta: las ventas de cada canal junto a las alertas de ruptura de frío, en la misma línea de tiempo.",
