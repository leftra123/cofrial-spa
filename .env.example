# Copiar a .env y completar. .env está ignorado por git: nunca subir credenciales.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DB_NAME=cofrial
DB_USER=cofrial
DB_PASSWORD=cambiar-esta-clave
DB_HOST=db
DB_PORT=5432
DEMO_PASSWORD=cambiar-clave-de-demo
INTERVALO_SEG=5
PROB_RUPTURA=0.01
# Velocidad simulada de los camiones: 120 = modo demostración (un reparto termina en minutos); 30 coincide con la ETA de la web
VELOCIDAD_KMH=120
# Tablero de BI (Grafana): usuario de solo lectura de la base y cuenta admin del tablero
GRAFANA_DB_PASSWORD=cambiar-clave-solo-lectura
GRAFANA_PASSWORD=cambiar-clave-admin-grafana
# IA externa gratuita (Google AI Studio -> Get API key). La clave nunca va al repositorio. Respaldo opcional: Groq
# Mosaicos del mapa. Vacío = OpenStreetMap (sin clave; exige enviar el Referer y mostrar la atribución, ya resuelto en la web).
# Para otro proveedor, poner su URL con {z}/{x}/{y} (y su clave dentro de la URL si la pide) y su atribución. Ojo: Carto ya no es gratis sin clave.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_MAX_ZOOM=
MAP_TILE_SUBDOMAINS=
GEMINI_API_KEY=
# Opcional: modelos de Gemini separados por coma, en orden de preferencia. Vacío = los del código (hoy gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.5-flash)
GEMINI_MODELS=
GROQ_API_KEY=
# Opcional: orden de los proveedores de IA (gemini,groq por defecto) y modelos de Groq
# Proveedores del asistente de la tienda (chat); el orden por defecto es groq,gemini porque Groq responde en menos de 1 s.
ASISTENTE_ACTIVO=1
IA_CHAT_PROVEEDORES=
IA_PROVEEDORES=
GROQ_MODELS=
